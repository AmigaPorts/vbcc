-elf
-no-regnames
-no-multiple-ccs
-madd
-use-commons
-cc=PREFIX/bin/vbccppc -quiet %s -o= %s %s -O=%ld -IPREFIX/ppc-amigaos/vbcc/include -IPREFIX/ppc-amigaos/SDK/include/include_h -D__amigaos4__
-ccv=PREFIX/bin/vbccppc %s -o= %s %s -O=%ld -IPREFIX/ppc-amigaos/vbcc/include -IPREFIX/ppc-amigaos/SDK/include/include_h -D__amigaos4__
-as=PREFIX/bin/vasmppc_std -quiet -Felf -opt-branch -no-regnames -nowarn=62 %s -o %s
-asv=PREFIX/bin/vasmppc_std -Felf -opt-branch -no-regnames -nowarn=62 %s -o %s
-isc=PREFIX/bin/vscppc -quiet %s %s
-iscv=PREFIX/bin/vscppc %s %s
-rm=rm -f %s
-rmv=rm -f %s
-ld=PREFIX/bin/vlink -belf32amigaos -q -n -Cvbccelf -P_start -P__amigaos4__ -nostdlib -fixunnamed -interp "vbcc 0.9" -TPREFIX/ppc-amigaos/vbcc/lib/script PREFIX/ppc-amigaos/vbcc/lib/startup.o %s %s -LPREFIX/ppc-amigaos/vbcc/lib -lvc -o %s
-l2=PREFIX/bin/vlink -belf32amigaos -q -n -Cvbccelf -P_start -P__amigaos4__ -nostdlib -fixunnamed -interp "vbcc 0.9" -TPREFIX/ppc-amigaos/vbcc/lib/script %s %s -LPREFIX/ppc-amigaos/vbcc/lib -o %s
-ldv=PREFIX/bin/vlink -belf32amigaos -t -q -n -Cvbccelf -P_start -P__amigaos4__ -nostdlib -fixunnamed -interp "vbcc 0.9" -TPREFIX/ppc-amigaos/vbcc/lib/script PREFIX/ppc-amigaos/vbcc/lib/startup.o %s %s -LPREFIX/ppc-amigaos/vbcc/lib -lvc -o %s
-l2v=PREFIX/bin/vlink -belf32amigaos -t -q -n -Cvbccelf -P_start -P__amigaos4__ -nostdlib -fixunnamed -interp "vbcc 0.9" -TPREFIX/ppc-amigaos/vbcc/lib/script %s %s -LPREFIX/ppc-amigaos/vbcc/lib -o %s
-ldnodb=-s -x
-ldstatic=-Bstatic
-ul=-l%s
-cf=-F%s
-ml=500
